# GitHub App
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# GitHub Enterprise Server only, e.g. https://github.example.com/api/v3
# GITHUB_API_URL=https://api.github.com

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/sockpuppet

# Redis
REDIS_URL=redis://localhost:6379

# Integration tests only - this database is wiped by the test run
# TEST_DATABASE_URL=postgresql://user:password@localhost:5432/sockpuppet_test

# App
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
NODE_ENV=development

# Optional
LOG_LEVEL=info
# Webhook-triggered analyses are batched per repository over this window
ANALYSIS_DEBOUNCE_MS=60000
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# LLM Analysis (Optional - enhances detection accuracy)
LLM_ANALYSIS_ENABLED=false
# One of: ollama, openai, anthropic
LLM_PROVIDER=ollama
# Defaults: llama3.2 (ollama), gpt-5-mini (openai), claude-haiku-4-5-20251001 (anthropic)
LLM_MODEL=
# Required for openai and anthropic
LLM_API_KEY=
# For a local Ollama instance
OLLAMA_URL=http://localhost:11434
# Per-request timeout
LLM_TIMEOUT_MS=60000
